# 9RU5 -- generated by ../make_views.py
# Va = big sphere, Vb = small sphere. chains: A MHC, B peptide, C TCRa, D TCRb.
load 9RU5_native.cif, native
load 9RU5_AF3.cif, AF3
load 9RU5_ESMFold2.cif, ESM

bg_color white
hide everything
show cartoon
set cartoon_transparency, 0.55, native
color gray70, native
color firebrick, AF3
color teal, ESM
show sticks, chain B and not hydro
set cartoon_side_chain_helper, 1
set ray_shadows, 0
set antialias, 2
set orthoscopic, 1

pseudoatom native_Va, pos=[129.12,119.90,133.31], color=gray70
show spheres, native_Va
set sphere_scale, 4.0, native_Va
pseudoatom native_Vb, pos=[129.95,142.45,128.71], color=gray70
show spheres, native_Vb
set sphere_scale, 2.4, native_Vb
pseudoatom AF3_Va, pos=[128.60,123.87,133.53], color=firebrick
show spheres, AF3_Va
set sphere_scale, 4.0, AF3_Va
pseudoatom AF3_Vb, pos=[133.36,145.03,127.75], color=firebrick
show spheres, AF3_Vb
set sphere_scale, 2.4, AF3_Vb
pseudoatom ESM_Va, pos=[134.37,153.18,126.04], color=teal
show spheres, ESM_Va
set sphere_scale, 4.0, ESM_Va
pseudoatom ESM_Vb, pos=[128.57,132.02,132.33], color=teal
show spheres, ESM_Vb
set sphere_scale, 2.4, ESM_Vb
set sphere_transparency, 0.1, *_V*
disable *_V*

# whole complex, groove horizontal, native TCR up
set_view (\
  0.9718,-0.1584,-0.1748,-0.1845,-0.0482,-0.9816,0.1471,0.9862,-0.0761,\
  0.0,0.0,-250.0,\
  134.1821,132.5454,102.1959,\
  100.0,400.0,-20.0 )
zoom native or AF3 or ESM, 4
scene side, store

# same camera rotated onto the platform normal, viewed from the TCR side
set_view (\
  0.9718,0.1748,-0.1584,-0.1845,0.9816,-0.0482,0.1471,0.0761,0.9862,\
  0.0,0.0,-250.0,\
  134.1821,132.5454,102.1959,\
  100.0,400.0,-20.0 )
zoom native or AF3 or ESM, 4
scene top, store

# footprint: TCR bodies off, variable-domain centroids on
hide cartoon, chain C+D
enable *_V*
zoom chain A or chain B or *_V*, 4
scene footprint, store
show cartoon, chain C+D
disable *_V*

scene side, recall
