show /B & ~hydrogen atoms
style /B stick
set bgColor white
lighting soft; graphics silhouettes false
# groove horizontal, native TCR up (same camera as the PyMOL `side` scene)
view matrix camera 0.9718,-0.1584,-0.1748,95.7158,-0.1845,-0.0482,-0.9816,-83.4174,0.1471,0.9862,-0.0761,85.4505
