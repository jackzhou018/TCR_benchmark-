# 8QFY -- generated by ../make_views.py
# Va = big sphere, Vb = small sphere. chains: A MHC, B peptide, C TCRa, D TCRb.
load 8QFY_native.cif, native
load 8QFY_AF3.cif, AF3
load 8QFY_ESMFold2.cif, ESM

bg_color white
hide everything
show cartoon
set cartoon_transparency, 0.55, native
color gray70, native
color firebrick, AF3
color teal, ESM
show sticks, chain B and not hydro
set cartoon_side_chain_helper, 1
set ray_shadows, 0
set antialias, 2
set orthoscopic, 1

pseudoatom native_Va, pos=[33.00,-46.35,39.76], color=gray70
show spheres, native_Va
set sphere_scale, 4.0, native_Va
pseudoatom native_Vb, pos=[32.86,-43.35,16.06], color=gray70
show spheres, native_Vb
set sphere_scale, 2.4, native_Vb
pseudoatom AF3_Va, pos=[33.59,-47.26,39.56], color=firebrick
show spheres, AF3_Va
set sphere_scale, 4.0, AF3_Va
pseudoatom AF3_Vb, pos=[33.14,-43.91,15.94], color=firebrick
show spheres, AF3_Vb
set sphere_scale, 2.4, AF3_Vb
pseudoatom ESM_Va, pos=[32.76,-46.23,39.84], color=teal
show spheres, ESM_Va
set sphere_scale, 4.0, ESM_Va
pseudoatom ESM_Vb, pos=[32.78,-43.83,16.07], color=teal
show spheres, ESM_Vb
set sphere_scale, 2.4, ESM_Vb
set sphere_transparency, 0.1, *_V*
disable *_V*

# whole complex, groove horizontal, native TCR up
set_view (\
  -0.5973,-0.7896,0.1407,0.7367,-0.6095,-0.2927,0.3169,-0.0712,0.9458,\
  0.0,0.0,-250.0,\
  56.3614,-26.7207,29.9277,\
  100.0,400.0,-20.0 )
zoom native or AF3 or ESM, 4
scene side, store

# same camera rotated onto the platform normal, viewed from the TCR side
set_view (\
  -0.5973,-0.1407,-0.7896,0.7367,0.2927,-0.6095,0.3169,-0.9458,-0.0712,\
  0.0,0.0,-250.0,\
  56.3614,-26.7207,29.9277,\
  100.0,400.0,-20.0 )
zoom native or AF3 or ESM, 4
scene top, store

# footprint: TCR bodies off, variable-domain centroids on
hide cartoon, chain C+D
enable *_V*
zoom chain A or chain B or *_V*, 4
scene footprint, store
show cartoon, chain C+D
disable *_V*

scene side, recall
