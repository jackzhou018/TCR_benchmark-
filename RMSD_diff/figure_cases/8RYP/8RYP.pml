# 8RYP -- generated by ../make_views.py
# Va = big sphere, Vb = small sphere. chains: A MHC, B peptide, C TCRa, D TCRb.
load 8RYP_native.cif, native
load 8RYP_AF3.cif, AF3
load 8RYP_ESMFold2.cif, ESM

bg_color white
hide everything
show cartoon
set cartoon_transparency, 0.55, native
color gray70, native
color firebrick, AF3
color teal, ESM
show sticks, chain B and not hydro
set cartoon_side_chain_helper, 1
set ray_shadows, 0
set antialias, 2
set orthoscopic, 1

pseudoatom native_Va, pos=[-39.19,-15.49,-39.79], color=gray70
show spheres, native_Va
set sphere_scale, 4.0, native_Va
pseudoatom native_Vb, pos=[-17.01,-9.75,-39.88], color=gray70
show spheres, native_Vb
set sphere_scale, 2.4, native_Vb
pseudoatom AF3_Va, pos=[-38.87,-16.89,-39.53], color=firebrick
show spheres, AF3_Va
set sphere_scale, 4.0, AF3_Va
pseudoatom AF3_Vb, pos=[-17.21,-9.40,-40.28], color=firebrick
show spheres, AF3_Vb
set sphere_scale, 2.4, AF3_Vb
pseudoatom ESM_Va, pos=[-37.96,-15.70,-40.75], color=teal
show spheres, ESM_Va
set sphere_scale, 4.0, ESM_Va
pseudoatom ESM_Vb, pos=[-16.41,-8.35,-40.79], color=teal
show spheres, ESM_Vb
set sphere_scale, 2.4, ESM_Vb
set sphere_transparency, 0.1, *_V*
disable *_V*

# whole complex, groove horizontal, native TCR up
set_view (\
  -0.1464,-0.0526,-0.9878,0.9380,-0.3247,-0.1217,-0.3143,-0.9444,0.0969,\
  0.0,0.0,-250.0,\
  -26.5510,-2.8734,-11.7078,\
  100.0,400.0,-20.0 )
zoom native or AF3 or ESM, 4
scene side, store

# same camera rotated onto the platform normal, viewed from the TCR side
set_view (\
  -0.1464,0.9878,-0.0526,0.9380,0.1217,-0.3247,-0.3143,-0.0969,-0.9444,\
  0.0,0.0,-250.0,\
  -26.5510,-2.8734,-11.7078,\
  100.0,400.0,-20.0 )
zoom native or AF3 or ESM, 4
scene top, store

# footprint: TCR bodies off, variable-domain centroids on
hide cartoon, chain C+D
enable *_V*
zoom chain A or chain B or *_V*, 4
scene footprint, store
show cartoon, chain C+D
disable *_V*

scene side, recall
