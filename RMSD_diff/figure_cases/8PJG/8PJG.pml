# 8PJG -- generated by ../make_views.py
# Va = big sphere, Vb = small sphere. chains: A MHC, B peptide, D TCRa, E TCRb.
load 8PJG_native.cif, native
load 8PJG_AF3.cif, AF3
load 8PJG_ESMFold2.cif, ESM

bg_color white
hide everything
show cartoon
set cartoon_transparency, 0.55, native
color gray70, native
color firebrick, AF3
color teal, ESM
show sticks, chain B and not hydro
set cartoon_side_chain_helper, 1
set ray_shadows, 0
set antialias, 2
set orthoscopic, 1

pseudoatom native_Va, pos=[-20.48,16.14,-34.06], color=gray70
show spheres, native_Va
set sphere_scale, 4.0, native_Va
pseudoatom native_Vb, pos=[-19.75,28.61,-14.08], color=gray70
show spheres, native_Vb
set sphere_scale, 2.4, native_Vb
pseudoatom AF3_Va, pos=[-20.86,15.92,-34.09], color=firebrick
show spheres, AF3_Va
set sphere_scale, 4.0, AF3_Va
pseudoatom AF3_Vb, pos=[-19.68,27.96,-13.83], color=firebrick
show spheres, AF3_Vb
set sphere_scale, 2.4, AF3_Vb
pseudoatom ESM_Va, pos=[-20.78,16.29,-34.66], color=teal
show spheres, ESM_Va
set sphere_scale, 4.0, ESM_Va
pseudoatom ESM_Vb, pos=[-19.92,27.45,-13.88], color=teal
show spheres, ESM_Vb
set sphere_scale, 2.4, ESM_Vb
set sphere_transparency, 0.1, *_V*
disable *_V*

# whole complex, groove horizontal, native TCR up
set_view (\
  0.3916,0.9055,-0.1636,0.9031,-0.4123,-0.1201,-0.1762,-0.1007,-0.9792,\
  0.0,0.0,-250.0,\
  -45.8637,34.2371,-22.0718,\
  100.0,400.0,-20.0 )
zoom native or AF3 or ESM, 4
scene side, store

# same camera rotated onto the platform normal, viewed from the TCR side
set_view (\
  0.3916,0.1636,0.9055,0.9031,0.1201,-0.4123,-0.1762,0.9792,-0.1007,\
  0.0,0.0,-250.0,\
  -45.8637,34.2371,-22.0718,\
  100.0,400.0,-20.0 )
zoom native or AF3 or ESM, 4
scene top, store

# footprint: TCR bodies off, variable-domain centroids on
hide cartoon, chain D+E
enable *_V*
zoom chain A or chain B or *_V*, 4
scene footprint, store
show cartoon, chain D+E
disable *_V*

scene side, recall
