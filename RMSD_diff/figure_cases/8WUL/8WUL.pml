# 8WUL -- generated by ../make_views.py
# Va = big sphere, Vb = small sphere. chains: A MHC, B peptide, C TCRa, D TCRb.
load 8WUL_native.cif, native
load 8WUL_AF3.cif, AF3
load 8WUL_ESMFold2.cif, ESM

bg_color white
hide everything
show cartoon
set cartoon_transparency, 0.55, native
color gray70, native
color firebrick, AF3
color teal, ESM
show sticks, chain B and not hydro
set cartoon_side_chain_helper, 1
set ray_shadows, 0
set antialias, 2
set orthoscopic, 1

pseudoatom native_Va, pos=[6.21,18.34,-51.02], color=gray70
show spheres, native_Va
set sphere_scale, 4.0, native_Va
pseudoatom native_Vb, pos=[-7.39,36.78,-46.10], color=gray70
show spheres, native_Vb
set sphere_scale, 2.4, native_Vb
pseudoatom AF3_Va, pos=[2.26,16.95,-53.25], color=firebrick
show spheres, AF3_Va
set sphere_scale, 4.0, AF3_Va
pseudoatom AF3_Vb, pos=[-9.04,36.31,-46.73], color=firebrick
show spheres, AF3_Vb
set sphere_scale, 2.4, AF3_Vb
pseudoatom ESM_Va, pos=[2.50,16.41,-53.75], color=teal
show spheres, ESM_Va
set sphere_scale, 4.0, ESM_Va
pseudoatom ESM_Vb, pos=[-7.83,36.31,-46.60], color=teal
show spheres, ESM_Vb
set sphere_scale, 2.4, ESM_Vb
set sphere_transparency, 0.1, *_V*
disable *_V*

# whole complex, groove horizontal, native TCR up
set_view (\
  0.7808,-0.0939,0.6177,0.5292,-0.4261,-0.7337,0.3321,0.8998,-0.2830,\
  0.0,0.0,-250.0,\
  2.0886,40.2447,-74.7314,\
  100.0,400.0,-20.0 )
zoom native or AF3 or ESM, 4
scene side, store

# same camera rotated onto the platform normal, viewed from the TCR side
set_view (\
  0.7808,-0.6177,-0.0939,0.5292,0.7337,-0.4261,0.3321,0.2830,0.8998,\
  0.0,0.0,-250.0,\
  2.0886,40.2447,-74.7314,\
  100.0,400.0,-20.0 )
zoom native or AF3 or ESM, 4
scene top, store

# footprint: TCR bodies off, variable-domain centroids on
hide cartoon, chain C+D
enable *_V*
zoom chain A or chain B or *_V*, 4
scene footprint, store
show cartoon, chain C+D
disable *_V*

scene side, recall
