# 8RYO -- generated by ../make_views.py
# Va = big sphere, Vb = small sphere. chains: A MHC, B peptide, C TCRa, D TCRb.
load 8RYO_native.cif, native
load 8RYO_AF3.cif, AF3
load 8RYO_ESMFold2.cif, ESM

bg_color white
hide everything
show cartoon
set cartoon_transparency, 0.55, native
color gray70, native
color firebrick, AF3
color teal, ESM
show sticks, chain B and not hydro
set cartoon_side_chain_helper, 1
set ray_shadows, 0
set antialias, 2
set orthoscopic, 1

pseudoatom native_Va, pos=[5.99,23.22,46.76], color=gray70
show spheres, native_Va
set sphere_scale, 4.0, native_Va
pseudoatom native_Vb, pos=[18.93,3.95,47.78], color=gray70
show spheres, native_Vb
set sphere_scale, 2.4, native_Vb
pseudoatom AF3_Va, pos=[19.19,-9.60,-4.86], color=firebrick
show spheres, AF3_Va
set sphere_scale, 4.0, AF3_Va
pseudoatom AF3_Vb, pos=[38.17,-4.99,7.20], color=firebrick
show spheres, AF3_Vb
set sphere_scale, 2.4, AF3_Vb
pseudoatom ESM_Va, pos=[6.26,23.32,46.59], color=teal
show spheres, ESM_Va
set sphere_scale, 4.0, ESM_Va
pseudoatom ESM_Vb, pos=[18.56,4.01,48.12], color=teal
show spheres, ESM_Vb
set sphere_scale, 2.4, ESM_Vb
set sphere_transparency, 0.1, *_V*
disable *_V*

# whole complex, groove horizontal, native TCR up
set_view (\
  -0.5914,0.0096,-0.8063,-0.7916,0.1834,0.5828,0.1535,0.9830,-0.1008,\
  0.0,0.0,-250.0,\
  12.1439,7.9640,17.9706,\
  100.0,400.0,-20.0 )
zoom native or AF3 or ESM, 4
scene side, store

# same camera rotated onto the platform normal, viewed from the TCR side
set_view (\
  -0.5914,0.8063,0.0096,-0.7916,-0.5828,0.1834,0.1535,0.1008,0.9830,\
  0.0,0.0,-250.0,\
  12.1439,7.9640,17.9706,\
  100.0,400.0,-20.0 )
zoom native or AF3 or ESM, 4
scene top, store

# footprint: TCR bodies off, variable-domain centroids on
hide cartoon, chain C+D
enable *_V*
zoom chain A or chain B or *_V*, 4
scene footprint, store
show cartoon, chain C+D
disable *_V*

scene side, recall
